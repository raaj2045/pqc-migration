# Compiled tool binaries (built by `go build` in tools/*).
/tools/block_packing/block_packing
/tools/loadgen/loadgen
/tools/storage_sim/storage_sim

# Local devnet node_modules (a shared install, not part of the repo).
/devnet-node-modules/

# Toolchain downloads and runtime pidfiles.
/protoc-*.zip
/proof-api.pid

# Stray measurement output at the repository root. Everything now lives under
# the experiment that produced it; these patterns only catch leftovers.
/migration_metrics*.csv
/*.pdf

# Raw per-run experiment data. Regenerate by re-running against your own
# devnet; only the scripts that produce it are tracked. migration_throughput is
# the exception — its result set is committed evidence and stays tracked.
experiments/*/results/
!experiments/migration_throughput/results/
experiments/*/logs/
experiments/*/sweep_state.json
