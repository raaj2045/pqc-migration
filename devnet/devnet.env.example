# Devnet configuration for the redemption scripts.
#
# Copy to devnet.env and adjust, or override any value by exporting it in the
# environment (the environment always wins over this file).
#
#   cp devnet.env.example devnet.env
#   DEVNET_DIR=/somewhere/else node step-redeem-send.js 500000
#
# Placeholders expanded by the config layer (lib/config.js, lib/config.py):
#
#   $DEVNET_ROOT  this devnet/ directory. Entries pointing at scripts shipped
#                 in this repository use it, so they work unedited.
#   $HOME, ~      your home directory.
#
# Anything written as /path/to/... is NOT expanded: it names something you
# provide separately and must edit before use.

# ---------------------------------------------------------------------------
# Working directory
# ---------------------------------------------------------------------------
# Holds the generated env files (ports.env, cosmos.env, deploy.env), the
# relayer helpers, and the JSON hand-off files these scripts write between
# steps (redeem-send.json, redeem-ack.json).
DEVNET_DIR=$HOME/devnet-workdir

# ---------------------------------------------------------------------------
# Cosmos chain
# ---------------------------------------------------------------------------
# Must be a build that does NOT register x/lockandmint. The module was retired
# in 7141068, so a binary predating that panics on current chain data with
# "version of store lockandmint mismatch root store's version".
PQCHAIND_BIN=/path/to/pqchaind
CHAIN_HOME=$HOME/devnet-workdir/chain
CHAIN_ID=pqc-5-1
CHAIN_NODE=tcp://127.0.0.1:26657

# Key name in the test keyring used to sign relayer transactions.
RELAYER_KEY=validator

# ---------------------------------------------------------------------------
# proof-api (real SP1 proving)
# ---------------------------------------------------------------------------
# The forward leg (Cosmos -> EVM) is proved by solidity-ibc-eureka's proof-api,
# which must already be running against this devnet. Start it with a config
# whose cosmos_to_eth module points at CHAIN_NODE and GETH_RPC, and whose
# sp1_prover is {"type":"cpu"}; see devnet/README.md.
PROOF_API_ADDR=127.0.0.1:39590
PROOF_API_PROTO=/path/to/solidity-ibc-eureka/proto/proofapi/proofapi.proto

# ---------------------------------------------------------------------------
# Helper commands (see README: these are prerequisites, not part of devnet/)
# ---------------------------------------------------------------------------
# Advances the Ethereum light client on the Cosmos chain. Invoked by
# step-redeem-recv.js with the Cosmos client id as its only argument.
UPDATE_CLIENT_CMD=python3 $DEVNET_ROOT/relayer/update-eth-client.py

# Assembles, signs (ML-DSA-65) and broadcasts a Cosmos tx from a message JSON
# file. Invoked as: <cmd> <msg.json> <key-name> <gas>
SENDTX_CMD=python3 $DEVNET_ROOT/cosmos/sendtx.py

# Relays the Cosmos -> EVM (forward) leg for one packet: updates the EVM-side
# light client to the Cosmos height that commits the packet, then submits
# recvPacket. Invoked as: <cmd> <cosmos-tx-hash>
#
# This lives in devnet/ and is parameterized through this same config layer,
# so it needs no path of its own.
RECV_CMD=node $DEVNET_ROOT/step-recv.js

# Relays the EVM -> Cosmos (return/ack) leg for one packet, verified by the
# REAL Ethereum light client. Invoked as: <cmd> <recv-result.json>
#
# This is the leg that waits for genuine Ethereum finality and triggers the
# BLS-verifying MsgUpdateClient, so it is the leg the throughput experiment
# measures. See experiments/migration_throughput/README.md.
ACK_CMD=node $DEVNET_ROOT/step-ack.js

# ---------------------------------------------------------------------------
# Endpoints
# ---------------------------------------------------------------------------
# Left blank, these are read from $DEVNET_DIR/ports.env, which is generated by:
#   kurtosis port print eth-devnet cl-1-lighthouse-geth http   -> BEACON
#   kurtosis port print eth-devnet el-1-geth-lighthouse rpc    -> GETH_RPC
BEACON_URL=
GETH_RPC=

# ---------------------------------------------------------------------------
# Contracts / identifiers
# ---------------------------------------------------------------------------
# Left blank, these are read from $DEVNET_DIR/deploy.env.
ICS26_ROUTER=
ICS20_TRANSFER=
IBCERC20=
ETH_CLIENT_ID=
COSMOS_CLIENT_ID=
RECEIVER_ADDR=
RECEIVER_PK=

# Ethereum-native test asset (devnet/deploy/TestERC20.sol), escrowed rather
# than minted/burned since it is never registered as an IBCERC20 voucher.
# Deployed by deploy-test-token.sh; used by step-native-{send,recv,ack}.js.
TEST_ERC20=

# Storage slot of the IBC commitment mapping inside ICS26Router. This is a
# contract constant (ics26router.IbcStoreStorageSlot), not a deployment value.
IBC_COMMITMENT_SLOT=0x1260944489272988d9df285149b5aa1b0f48f2136d6f416159f840a3e0747600

# ---------------------------------------------------------------------------
# Load generator (experiments/migration_throughput)
# ---------------------------------------------------------------------------
# Key in the test keyring whose ML-DSA-65 account funds the transfers, and the
# per-transfer amount. LOADGEN_KEY must differ from RELAYER_KEY so that
# loadgen submissions never contend for the relayer's account sequence.
LOADGEN_KEY=user5
LOADGEN_DENOM=stake
LOADGEN_AMOUNT=1000
