@@ -6,9 +6,11 @@ import (
 	"encoding/json"
 	"errors"
 	"fmt"
+	"net"
 	"os"
 	"os/exec"
 	"strconv"
+	"syscall"
 	"time"
 
 	"github.com/cosmos/gogoproto/proto"
@@ -57,12 +59,72 @@ func StartProofAPI(configPath string) (*os.Process, error) {
 		return nil, err
 	}
 
-	// wait for the proof API to start
-	time.Sleep(9 * time.Second)
+	// wait for the proof API to actually accept connections
+	addr, err := serverAddrFromConfig(config)
+	if err != nil {
+		addr = DefaultProofAPIGRPCAddress()
+	}
+	if err := waitForProofAPI(cmd.Process, addr, proofAPIReadyTimeout); err != nil {
+		_ = cmd.Process.Kill()
+		return nil, err
+	}
 
 	return cmd.Process, nil
 }
 
+// proofAPIReadyTimeout bounds how long StartProofAPI waits for the gRPC listener
+// to bind. The listener only binds after every module's create_service has
+// returned, and the local CPU prover's ProverClient::builder().cpu().build() takes
+// ~24s on its own (measured 23.6s and 24.2s over two runs on 6c/12t). 75s is 3x
+// that worst case, which also clears the 60s minimum we want on slower machines.
+// The wait is a poll, not a sleep, so a fast prover (e.g. mock) still returns in
+// milliseconds.
+const proofAPIReadyTimeout = 75 * time.Second
+
+// serverAddrFromConfig extracts the gRPC listen address from the proof API config.
+func serverAddrFromConfig(config []byte) (string, error) {
+	var parsed struct {
+		Server struct {
+			Address string `json:"address"`
+			Port    int    `json:"port"`
+		} `json:"server"`
+	}
+	if err := json.Unmarshal(config, &parsed); err != nil {
+		return "", fmt.Errorf("failed to parse proof API config: %w", err)
+	}
+	if parsed.Server.Address == "" || parsed.Server.Port == 0 {
+		return "", errors.New("proof API config has no server address or port")
+	}
+
+	return net.JoinHostPort(parsed.Server.Address, strconv.Itoa(parsed.Server.Port)), nil
+}
+
+// waitForProofAPI polls addr until the proof API accepts a connection. It fails
+// fast if the process exits rather than waiting out the full timeout.
+func waitForProofAPI(process *os.Process, addr string, timeout time.Duration) error {
+	start := time.Now()
+	deadline := start.Add(timeout)
+
+	for {
+		conn, err := net.DialTimeout("tcp", addr, time.Second)
+		if err == nil {
+			_ = conn.Close()
+			fmt.Printf("Proof API listening on %s after %s\n", addr, time.Since(start).Round(time.Millisecond))
+			return nil
+		}
+
+		if sigErr := process.Signal(syscall.Signal(0)); sigErr != nil {
+			return fmt.Errorf("proof API exited after %s without listening on %s", time.Since(start).Round(time.Millisecond), addr)
+		}
+
+		if time.Now().After(deadline) {
+			return fmt.Errorf("proof API did not listen on %s within %s", addr, timeout)
+		}
+
+		time.Sleep(250 * time.Millisecond)
+	}
+}
