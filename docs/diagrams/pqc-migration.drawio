        <mxCell id="s9l" value="&lt;font style=&quot;color: rgb(199, 53, 0); font-size: 10px;&quot;&gt;&lt;b&gt;9. multicall of ackPacket&lt;/b&gt;&lt;br&gt;&lt;i&gt;verify, then clear the commitments&lt;/i&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="672" y="672" width="150" height="34" as="geometry" />
        </mxCell>

        <mxCell id="keyNote" value="&lt;b&gt;Where the signature under test is used.&lt;/b&gt; Only two transactions carry it: &lt;i&gt;MsgUpdateClient&lt;/i&gt; and the batched &lt;i&gt;MsgRecvPacket&lt;/i&gt;, both signed by the relayer&#39;s Cosmos account with either secp256k1 or ML-DSA-65. Every Ethereum transaction on this path stays secp256k1, and receivers hold no key on chain until they first spend." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#999999;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="890" width="250" height="88" as="geometry" />
        </mxCell>
      </root>
