          <mxGeometry x="490" y="14" width="315" height="124" as="geometry" />
        </mxCell>
        <mxCell id="pnlBt" value="&lt;b&gt;ICS-20 over ibc-go channel v2&lt;/b&gt; &lt;font style=&quot;font-size: 9px;&quot;&gt;(no custom module)&lt;/font&gt;&#10;&#10;&lt;i&gt;/ibc.core.channel.v2.MsgRecvPacket&lt;/i&gt;&#10;&#160; { packet, proof_commitment, proof_height, signer }&#10;- N of these ride in ONE Cosmos transaction&#10;- mints the ibc/ voucher denomination to each receiver&#10;- writes the acknowledgement in the same transaction" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="494" y="18" width="307" height="116" as="geometry" />
        </mxCell>
        <mxCell id="pnlBl1" style="endArrow=none;html=1;rounded=0;strokeColor=#d6b656;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="pnlB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pnlBl2" style="endArrow=none;html=1;rounded=0;strokeColor=#d6b656;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="pnlB">
