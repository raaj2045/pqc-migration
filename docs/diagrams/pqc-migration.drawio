        <mxCell id="s8l" value="&lt;font style=&quot;color: rgb(184, 84, 80); font-size: 10px;&quot;&gt;&lt;b&gt;8. RelayByTx, then one SP1 Groth16 proof&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="366" width="180" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#C73500;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="brg4" target="e3">
