          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="pnlD" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;arcSize=0;" vertex="1" parent="1">
