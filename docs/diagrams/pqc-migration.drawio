        <mxCell id="pnlA" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;arcSize=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="300" height="124" as="geometry" />
        </mxCell>
        <mxCell id="pnlAt" value="&lt;b&gt;cw-ics08-wasm-eth&lt;/b&gt; &lt;font style=&quot;font-size: 9px;&quot;&gt;(CosmWasm, inside 08-wasm)&lt;/font&gt;&#10;&#10;- &lt;i&gt;verify_client_message(consensus_update)&lt;/i&gt;&#10;&#160; BLS-verifies the 512-key sync committee&#10;- &lt;i&gt;update_state(...)&lt;/i&gt; stores the &lt;b&gt;execution&lt;/b&gt; state root&#10;- &lt;i&gt;verify_membership(root, key, value, proof)&lt;/i&gt;&#10;&#160; checks one Merkle-Patricia proof per packet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="24" y="18" width="292" height="116" as="geometry" />
        </mxCell>
        <mxCell id="pnlAl1" style="endArrow=none;html=1;rounded=0;strokeColor=#b85450;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="pnlA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pnlAl2" style="endArrow=none;html=1;rounded=0;strokeColor=#b85450;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="pnlA">
