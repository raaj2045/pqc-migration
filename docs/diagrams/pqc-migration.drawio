        <mxCell id="brg4" value="&lt;b&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;proof-api&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size: 9px;&quot;&gt;(solidity-ibc-eureka) &#8212; SP1 Groth16&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="brg">
          <mxGeometry x="14" y="162" width="222" height="26" as="geometry" />
