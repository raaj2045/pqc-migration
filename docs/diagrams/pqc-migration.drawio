        <mxCell id="ttl" value="Proposed Framework: Migrating Assets to a Post-Quantum Chain" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontFamily=Tahoma;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="747" height="26" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Value is escrowed on the source chain and represented by a voucher on the target chain. A relayer carries proofs between them&#10;but is never trusted: each chain runs a light client of the other and verifies its consensus itself." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="52" width="707" height="32" as="geometry" />
        </mxCell>

