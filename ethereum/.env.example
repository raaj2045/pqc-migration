# Copy this file to .env and fill in your values.
# The .env file is gitignored.

# Ethereum Configuration
ETHEREUM_RPC_URL=http://localhost:8545

# Cosmos Configuration
COSMOS_CLI_PATH=../cosmos/build/simd
COSMOS_CHAIN_ID=test-1
COSMOS_FROM_KEY=validator

# Relayer Configuration
POLL_INTERVAL=5000

# Durable queue (SQLite, WAL journal). Directory is created if missing.
RELAYER_DB_PATH=./data/relayer.sqlite

# Worker-pool concurrency (number of simd mint submissions in flight).
RELAYER_CONCURRENCY=4

# Maximum attempts before a lock event is terminally marked 'failed'.
RELAYER_MAX_ATTEMPTS=5

# Prometheus /metrics HTTP port.
RELAYER_METRICS_PORT=9464

# Log verbosity for JSON logs: debug|info|warn|error
RELAYER_LOG_LEVEL=info
